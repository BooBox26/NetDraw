# ==============================================================================
# NETDRAW frontend environment template
# ==============================================================================
# Copy to `.env` (Vite picks it up automatically). All values are
# SAFE, GENERIC PLACEHOLDERS — never commit a real .env file.

# Vite dev server port
VITE_PORT=5173

# Public base URL for the API (no trailing slash).
# In Docker, the Nginx reverse proxy is used and this can stay empty.
VITE_API_BASE_URL=

# Comma-separated list of origins allowed by CSP at runtime.
# Override only if you need to allow custom embed origins.
VITE_CSP_ALLOWED_ORIGINS=
