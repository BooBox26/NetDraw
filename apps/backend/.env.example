# ==============================================================================
# NETDRAW backend environment template
# ==============================================================================
# Copy to `.env` and adjust. All values below are SAFE, GENERIC PLACEHOLDERS.
# Never commit a real `.env` file to source control.

# HTTP server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database
# Default: SQLite file inside the /data volume (recommended for self-hosting).
DATABASE_URL="file:/data/netdraw.db"
# PostgreSQL example (uncomment and adapt):
# DATABASE_URL="postgresql://netdraw:CHANGE_ME@postgres:5432/netdraw"

# CORS — comma-separated list. Use * only for local debugging.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Authentication (optional). 'none' (default), 'local', or 'oidc'
AUTH_MODE=none

# JWT secret. Generate a strong one in production: `openssl rand -hex 32`
JWT_SECRET=please-change-me-in-production-32chars-min
JWT_TTL=12h

# OIDC (only when AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# File storage
DATA_DIR=/data
MAX_UPLOAD_MB=2

# Snapshots / autosave
AUTOSAVE_INTERVAL_MS=30000

# Telemetry (opt-in, default OFF)
TELEMETRY_ENABLED=false
