# ==============================================================================
# NETDRAW Environment Variables Template
# ==============================================================================
# Copy this file to `.env` at the project root and adjust the values for your
# deployment. NEVER commit a real `.env` file to source control.
# All values shown below are SAFE, GENERIC PLACEHOLDERS.

# ------------------------------------------------------------------------------
# 1. Deployment & Ports
# ------------------------------------------------------------------------------

# Local frontend dev port (Vite dev server)
FRONTEND_PORT=5173

# Production port (external port exposed by the Nginx reverse-proxy)
PROD_PORT=8080

# Node Environment: development | test | production
NODE_ENV=development

# Logger verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Backend server (apps/backend)
# ------------------------------------------------------------------------------

# Bind host for the Fastify server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001

# Database Connection URL.
# Default: SQLite file inside the /data volume (recommended for self-hosting).
DATABASE_URL="file:/data/netdraw.db"
# PostgreSQL example (uncomment and adapt):
# DATABASE_URL="postgresql://netdraw:CHANGE_ME@postgres:5432/netdraw"

# ------------------------------------------------------------------------------
# 3. Security & access control
# ------------------------------------------------------------------------------

# Comma-separated list of allowed CORS origins. Use * ONLY for local debugging.
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

# Rate limit (requests per window per IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"

# Authentication mode: none | local | oidc
AUTH_MODE=none

# JWT signing secret. MUST be at least 32 characters in production.
# Generate with: `openssl rand -hex 32`
JWT_SECRET="please-change-me-in-production-32chars-min"
JWT_TTL="12h"

# OIDC parameters (only used when AUTH_MODE=oidc)
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI=""

# ------------------------------------------------------------------------------
# 4. Storage & limits
# ------------------------------------------------------------------------------

# Root path for runtime data (SQLite DB, exports, snapshots)
DATA_DIR="/data"

# Maximum allowed SVG upload size in Megabytes
MAX_UPLOAD_MB=2

# ------------------------------------------------------------------------------
# 5. Snapshots & autosave
# ------------------------------------------------------------------------------

# Auto-save interval in milliseconds
AUTOSAVE_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 6. Telemetry (opt-in, default OFF)
# ------------------------------------------------------------------------------

# Set to true to enable anonymous usage telemetry. Default false.
TELEMETRY_ENABLED=false
